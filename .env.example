# Copy this file to .env for local runs (Railway: set these as service variables instead)

PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-string

# YouTube (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
# Enable "YouTube Data API v3" first. Redirect URI to register:
#   {BASE_URL}/connect/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook + Instagram (developers.facebook.com -> Create App -> Facebook Login)
# Redirect URIs to register:
#   {BASE_URL}/connect/facebook/callback
#   {BASE_URL}/connect/instagram/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# X / Twitter (developer.x.com -> Project/App -> User authentication settings -> OAuth 2.0)
# Redirect URI to register:
#   {BASE_URL}/connect/x/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn (developer.linkedin.com -> Create App -> Auth tab)
# Redirect URI to register:
#   {BASE_URL}/connect/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
